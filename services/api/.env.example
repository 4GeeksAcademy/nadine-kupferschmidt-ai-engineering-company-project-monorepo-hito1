# Copiá este archivo como .env y completá los valores.

# Clave para firmar los tokens JWT (cualquier texto largo y secreto)
SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Restablecimiento de contraseña
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) — API key con permiso "Sending access"
RESEND_API_KEY=re_tu_api_key
# Opcional: remitente. Con el de prueba de Resend solo se puede enviar al email de tu cuenta.
EMAIL_FROM=Brasaland <onboarding@resend.dev>