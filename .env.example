# Copia este archivo como .env y completa los valores vacíos

# ===== Backend (services) =====
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
# La abre el navegador desde el link del mail, por eso es localhost
FRONTEND_URL=http://localhost:3000

# ===== Interfaces (uis) =====
# API externa del tracker (está en internet, no en Docker)
NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1
# El servidor de Next.js llama a la API desde dentro de Docker: nombre del servicio
API_URL=http://services:8000
